{
  "expo": {
    "name": "ADAR DocIntel",
    "slug": "adar-docintel",
    "scheme": "adardocintel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121F10"
    },
    "ios": {
      "bundleIdentifier": "com.agomoniai.adardocintel",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "DocIntel",
        "NSMicrophoneUsageDescription": "ADAR DocIntel uses your microphone to transcribe voice questions.",
        "NSPhotoLibraryUsageDescription": "ADAR DocIntel accesses your photo library so you can choose videos to upload."
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.agomoniai.docintel",
      "adaptiveIcon": {
        "backgroundColor": "#121F10",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ADAR DocIntel accesses your photo library so you can choose videos to upload."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "newArchEnabled": true,
    "owner": "brajadas",
    "extra": {
      "eas": {
        "projectId": "572a6a8e-a997-470e-879a-bccd1dbb0a15"
      }
    }
  }
}
