{
  "expo": {
    "name": "ADAR Eats",
    "slug": "adar-eats",
    "scheme": "adareats",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b2430"
    },
    "ios": {
      "bundleIdentifier": "com.agomoniai.adareats",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "ADAR Eats",
        "NSMicrophoneUsageDescription": "ADAR Eats uses your microphone to record a spoken restaurant menu for review.",
        "NSCameraUsageDescription": "ADAR Eats uses your camera to take photos of menu items.",
        "NSPhotoLibraryUsageDescription": "ADAR Eats uses your photo library to choose photos of menu items.",
        "NSLocationWhenInUseUsageDescription": "ADAR Eats uses your location to show restaurants and menus near you and to filter dine-in reservations by distance."
      }
    },
    "android": {
      "package": "com.agomoniai.adareats",
      "adaptiveIcon": {
        "backgroundColor": "#1b2430",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1b2430"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ADAR Eats uses your location to show restaurants and menus near you and to filter dine-in reservations by distance."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eb12a68e-0bdf-4c39-ab96-195167665540"
      }
    },
    "owner": "brajadas",
    "newArchEnabled": true
  }
}
